# Copy this file to .env.local (never commit .env.local) and fill in the two
# values from Supabase > Project Settings > API.
#
# Both are PUBLIC by design: the anon key is only a doorway; the Row Level
# Security rules in supabase/schema.sql protect the data.
# NEVER put the Supabase "service_role" key anywhere in this project.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
