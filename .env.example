# Public Supabase credentials (safe to expose in the browser bundle).
# Supabase > Project Settings > API > Project URL / anon public key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only Supabase secret. Used by the IT Super Admin API to create Auth
# users and write public.department_heads. NEVER prefix this with VITE_ and
# never commit a real value.
SUPABASE_SERVICE_ROLE_KEY=

# Optional local-development only. There is no built-in default; when this is
# empty the legacy /api/admin/login password endpoint is disabled.
ADMIN_PASSWORD=
