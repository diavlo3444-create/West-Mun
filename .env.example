# Client-side Supabase credentials (public anon key)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-side Supabase service role secret (Never expose to frontend/VITE_)
# Required in Vercel Project Settings > Environment Variables for IT Super Admin
# to create real Supabase Auth accounts and send email invitations from the website.
SUPABASE_SERVICE_ROLE_KEY=